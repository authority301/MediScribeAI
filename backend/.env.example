DATABASE_URL=postgresql+psycopg2://<username>:<password>@localhost:5432/mediscribeai
JWT_SECRET_KEY=<replace-with-a-secure-random-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
HF_TOKEN=<your-huggingface-token>
DIARIZATION_DEVICE=cpu
SOAP_MODEL_PROVIDER=local
SOAP_MODEL_NAME=deterministic-baseline
EVIDENCE_TOP_K=3
EVIDENCE_MIN_SCORE=0.15
NLI_MODEL_PROVIDER=local
NLI_MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_DEVICE=cpu
NLI_ENTAILMENT_THRESHOLD=0.70
NLI_CONTRADICTION_THRESHOLD=0.70
